# すべてテキストは正規化
*           text=auto

# LF を必須にしたいもの（bash / yml / js / ts / md / json など）
*.sh        text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.md        text eol=lf
*.json      text eol=lf
*.js        text eol=lf
*.mjs       text eol=lf
*.ts        text eol=lf
*.tsx       text eol=lf
*.eslint*   text eol=lf
*.prettierrc* text eol=lf

# C# もLFで統一するなら（おすすめ）
*.cs        text eol=lf
*.csproj    text eol=lf
*.sln       text eol=lf

# WindowsネイティブのバッチだけCRLFにしたい場合
*.bat       text eol=crlf
*.cmd       text eol=crlf

# バイナリ
*.png       binary
*.jpg       binary
*.dll       binary
*.exe       binary
*.wav       binary
